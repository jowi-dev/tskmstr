# One autopilot dispatch pass over every scope that is on (GitHub issue #117).
# Started by tm-dispatch.timer; see docs/dispatch-timer.md.
[Unit]
Description=tskmstr autopilot dispatch tick

[Service]
Type=oneshot
# Lane runs that a tick launches are detached supervisors, but they stay in
# this unit's cgroup. The default KillMode=control-group kills them as soon
# as the tick exits, so only the tick process itself may be killed.
KillMode=process
# A systemd user service gets a minimal PATH. tm, git, gh, tmux and your
# agent CLI (claude, opencode) must all be on it. Override PATH, or add
# JIRA_API_TOKEN, in the optional environment file.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/tskmstr/dispatch.env
ExecStart=/usr/bin/env tm dispatch tick --all
Nice=10
